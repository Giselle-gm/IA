CXX = g++
CXXFLAGS = -std=c++17 -Wall -Wextra -O2
CPPFLAGS = -Iinclude
SRC_DIR = src
BIN_DIR = bin
TEST_VARIANTS = $(BIN_DIR)/test_greedy_variants
TEST_VARIANTS_OBJS = $(BIN_DIR)/test_greedy_variants.o \
                     $(BIN_DIR)/$(SRC_DIR)/parser.o \
                     $(BIN_DIR)/$(SRC_DIR)/evaluator.o \
                     $(BIN_DIR)/$(SRC_DIR)/greedy_variants.o
all: test-greedy-variants
$(TEST_VARIANTS): $(TEST_VARIANTS_OBJS)
	mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) $^ -o $@
$(BIN_DIR)/%.o: %.cpp
	mkdir -p $(dir $@)
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -MMD -MP -c $< -o $@
test-greedy-variants: $(TEST_VARIANTS)
	./$(TEST_VARIANTS)
clean:
	rm -rf $(BIN_DIR) greedy_variants_comparison.csv
-include $(TEST_VARIANTS_OBJS:.o=.d)
.PHONY: all test-greedy-variants clean
